{
  "name": "vertigo-fr",
  "version": "3.0.3",
  "description": "Vertigo 3, the French language model of ParadoxalAI, with its own TypeScript engine. No dependency, no GPU.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": "github:nohamouazine/vertigo",
  "homepage": "https://paradoxalai.com",
  "keywords": [
    "french",
    "language-model",
    "llm",
    "wikipedia",
    "on-device"
  ],
  "bin": {
    "vertigo": "bin/vertigo.mjs"
  },
  "files": [
    "bin",
    "dist",
    "model",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "node --no-warnings scripts/build.mjs",
    "prepack": "npm run build",
    "ask": "node --experimental-strip-types engine/ask.ts",
    "test": "node --experimental-strip-types engine/test.ts",
    "bench": "node --experimental-strip-types bench/score.ts"
  }
}
